# Copy this file to .env.local (which is gitignored) and fill in your own
# project's values from Supabase → Project Settings → API.
#
# The anon key is safe to expose publicly — it ends up in the built JS bundle
# either way. Access control is enforced by Row Level Security policies on
# the database tables (see supabase/schema.sql), not by hiding this key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
